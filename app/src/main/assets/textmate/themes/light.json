{
  "name": "Light+",
  "type": "light",
  "colors": {
    "editor.background": "#FFFFFF",
    "editor.foreground": "#1F1F1F",
    "editor.lineHighlightBackground": "#F3F3F3",
    "editor.selectionBackground": "#ADD6FF",
    "editorCursor.foreground": "#000000",
    "editorLineNumber.foreground": "#6E7681",
    "editorLineNumber.activeForeground": "#1F1F1F"
  },
  "tokenColors": [
    {
      "scope": "comment",
      "settings": {
        "foreground": "#008000",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "string",
      "settings": {
        "foreground": "#A31515"
      }
    },
    {
      "scope": "constant.numeric",
      "settings": {
        "foreground": "#098658"
      }
    },
    {
      "scope": "constant.language",
      "settings": {
        "foreground": "#0000FF"
      }
    },
    {
      "scope": "constant.character.escape",
      "settings": {
        "foreground": "#EE0000"
      }
    },
    {
      "scope": "keyword",
      "settings": {
        "foreground": "#AF00DB"
      }
    },
    {
      "scope": "storage",
      "settings": {
        "foreground": "#AF00DB"
      }
    },
    {
      "scope": "storage.type",
      "settings": {
        "foreground": "#267F99"
      }
    },
    {
      "scope": "storage.type.annotation",
      "settings": {
        "foreground": "#795E26"
      }
    },
    {
      "scope": "entity.name.type",
      "settings": {
        "foreground": "#267F99"
      }
    },
    {
      "scope": "entity.name.function",
      "settings": {
        "foreground": "#795E26"
      }
    },
    {
      "scope": "support.function",
      "settings": {
        "foreground": "#795E26"
      }
    },
    {
      "scope": "entity.name.tag",
      "settings": {
        "foreground": "#AF00DB"
      }
    },
    {
      "scope": "entity.other.attribute-name",
      "settings": {
        "foreground": "#001080"
      }
    },
    {
      "scope": "support.type.property-name",
      "settings": {
        "foreground": "#001080"
      }
    },
    {
      "scope": "punctuation.definition.tag",
      "settings": {
        "foreground": "#800000"
      }
    },
    {
      "scope": "meta.preprocessor",
      "settings": {
        "foreground": "#AF00DB"
      }
    },
    {
      "scope": "keyword.control.directive",
      "settings": {
        "foreground": "#AF00DB"
      }
    },
    {
      "scope": "markup.heading",
      "settings": {
        "foreground": "#AF00DB",
        "fontStyle": "bold"
      }
    },
    {
      "scope": "markup.bold",
      "settings": {
        "foreground": "#795E26",
        "fontStyle": "bold"
      }
    },
    {
      "scope": "markup.italic",
      "settings": {
        "foreground": "#795E26",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "markup.inline.raw",
      "settings": {
        "foreground": "#A31515"
      }
    },
    {
      "scope": "markup.raw.block",
      "settings": {
        "foreground": "#A31515"
      }
    },
    {
      "scope": "markup.underline.link",
      "settings": {
        "foreground": "#001080",
        "fontStyle": "underline"
      }
    },
    {
      "scope": "markup.quote",
      "settings": {
        "foreground": "#008000",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "punctuation.definition.list",
      "settings": {
        "foreground": "#AF00DB"
      }
    }
  ]
}