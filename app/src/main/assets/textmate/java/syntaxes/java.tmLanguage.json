{
  "scopeName": "source.java",
  "name": "Java",
  "patterns": [
    {
      "name": "comment.block",
      "begin": "/\\*",
      "end": "\\*/"
    },
    {
      "name": "comment.line",
      "match": "//.*$"
    },
    {
      "name": "string.quoted.double",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape",
          "match": "\\\\(?:u[0-9a-fA-F]{4}|.)"
        }
      ]
    },
    {
      "name": "string.quoted.single",
      "begin": "'",
      "end": "'",
      "patterns": [
        {
          "name": "constant.character.escape",
          "match": "\\\\(?:u[0-9a-fA-F]{4}|.)"
        }
      ]
    },
    {
      "name": "constant.numeric",
      "match": "\\b(?:0[xX][0-9a-fA-F_]+|0[bB][01_]+|\\d[\\d_]*(?:\\.\\d+)?(?:[eE][+-]?\\d+)?[fFLlDdUu]*)\\b"
    },
    {
      "name": "storage.type.annotation",
      "match": "@[A-Za-z_][\\w.]*"
    },
    {
      "match": "^\\s*(import|package)\\s+([\\w.*]+)",
      "captures": {
        "1": {
          "name": "keyword.declaration"
        },
        "2": {
          "name": "entity.name.namespace"
        }
      }
    },
    {
      "match": "\\b(class|interface|enum|record|extends|implements|new)\\s+([A-Za-z_]\\w*)",
      "captures": {
        "1": {
          "name": "keyword.declaration"
        },
        "2": {
          "name": "entity.name.type"
        }
      }
    },
    {
      "name": "keyword.control",
      "match": "\\b(?:assert|break|case|catch|continue|default|do|else|finally|for|if|instanceof|return|switch|throw|throws|try|while|yield)\\b"
    },
    {
      "name": "storage.modifier",
      "match": "\\b(?:abstract|final|native|private|protected|public|static|strictfp|synchronized|transient|volatile|sealed|non-sealed|permits)\\b"
    },
    {
      "name": "storage.type.primitive",
      "match": "\\b(?:boolean|byte|char|double|float|int|long|short|void|var|String|Object)\\b"
    },
    {
      "name": "constant.language",
      "match": "\\b(?:true|false|null|this|super)\\b"
    },
    {
      "name": "entity.name.function",
      "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?=\\s*\\()"
    },
    {
      "name": "variable.other.property",
      "match": "(?<=\\.)[A-Za-z_][A-Za-z0-9_]*\\b(?!\\s*\\()"
    },
    {
      "name": "constant.other",
      "match": "\\b[A-Z][A-Z0-9_]{2,}\\b"
    },
    {
      "name": "entity.name.type",
      "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
    },
    {
      "name": "keyword.operator",
      "match": "[-+*/%=<>!&|^~?:]+"
    }
  ]
}