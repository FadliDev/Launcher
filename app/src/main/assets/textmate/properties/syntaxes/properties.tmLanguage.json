{
  "scopeName": "source.properties",
  "name": "Properties",
  "patterns": [
    {
      "name": "comment.line",
      "match": "^\\s*[#!].*$"
    },
    {
      "name": "support.type.property-name",
      "match": "^\\s*[^=:#!\\s][^=:\\s]*(?=\\s*[=:])"
    },
    {
      "name": "keyword.operator",
      "match": "[=:]"
    },
    {
      "name": "constant.numeric",
      "match": "\\b(?:0[xX][0-9a-fA-F_]+|0[bB][01_]+|\\d[\\d_]*(?:\\.\\d+)?(?:[eE][+-]?\\d+)?[fFLlDdUu]*)\\b"
    }
  ]
}