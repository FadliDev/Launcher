{
  "scopeName": "source.swift",
  "patterns": [
    {
      "name": "comment.block",
      "begin": "/\\*",
      "end": "\\*/"
    },
    {
      "name": "comment.line.double-slash",
      "match": "//.*$"
    },
    {
      "name": "string.quoted.double",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape",
          "match": "\\\\."
        }
      ]
    },
    {
      "name": "string.quoted.single",
      "begin": "'",
      "end": "'",
      "patterns": [
        {
          "name": "constant.character.escape",
          "match": "\\\\."
        }
      ]
    },
    {
      "name": "string.quoted.backtick",
      "begin": "`",
      "end": "`",
      "patterns": [
        {
          "name": "constant.character.escape",
          "match": "\\\\."
        }
      ]
    },
    {
      "name": "constant.numeric",
      "match": "\\b(?:0[xX][0-9a-fA-F]+|0[bB][01]+|\\d+(?:\\.\\d+)?(?:[eE][+-]?\\d+)?)\\b"
    },
    {
      "name": "keyword.control",
      "match": "\\b(?:associatedtype|fileprivate|fallthrough|typealias|extension|subscript|internal|rethrows|protocol|operator|continue|private|default|static|repeat|switch|import|return|struct|deinit|public|throws|break|while|false|class|super|defer|throw|inout|where|print|catch|guard|await|actor|async|Self|open|else|some|enum|self|init|true|case|func|Any|any|try|var|for|let|nil|is|in|as|do|if)\\b"
    },
    {
      "name": "entity.name.function",
      "match": "\\b[A-Za-z_$][\\w$]*(?=\\s*\\()"
    },
    {
      "name": "entity.name.type",
      "match": "\\b[A-Z][A-Za-z0-9_$]*\\b"
    },
    {
      "name": "constant.language",
      "match": "\\b(?:true|false|null|undefined|None|nil|NaN|Infinity|NULL|NoneType)\\b"
    }
  ]
}