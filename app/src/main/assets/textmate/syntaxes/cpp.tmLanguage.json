{
  "scopeName": "source.cpp",
  "patterns": [
    {
      "name": "comment.block",
      "begin": "/\\*",
      "end": "\\*/"
    },
    {
      "name": "comment.line.double-slash",
      "match": "//.*$"
    },
    {
      "name": "string.quoted.double",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape",
          "match": "\\\\."
        }
      ]
    },
    {
      "name": "string.quoted.single",
      "begin": "'",
      "end": "'",
      "patterns": [
        {
          "name": "constant.character.escape",
          "match": "\\\\."
        }
      ]
    },
    {
      "name": "string.quoted.backtick",
      "begin": "`",
      "end": "`",
      "patterns": [
        {
          "name": "constant.character.escape",
          "match": "\\\\."
        }
      ]
    },
    {
      "name": "constant.numeric",
      "match": "\\b(?:0[xX][0-9a-fA-F]+|0[bB][01]+|\\d+(?:\\.\\d+)?(?:[eE][+-]?\\d+)?)\\b"
    },
    {
      "name": "keyword.control",
      "match": "\\b(?:reinterpret_cast|static_assert|thread_local|static_cast|constinit|co_return|protected|consteval|constexpr|namespace|char16_t|decltype|co_await|template|register|unsigned|explicit|continue|co_yield|typename|volatile|noexcept|operator|requires|char32_t|private|typedef|alignas|alignof|virtual|nullptr|default|char8_t|wchar_t|mutable|double|switch|extern|vector|friend|static|typeid|signed|return|sizeof|string|delete|inline|export|struct|public|catch|while|const|union|break|class|short|using|float|false|throw|case|else|true|this|bool|char|enum|long|void|auto|cout|goto|and|for|cin|std|new|try|not|asm|int|do|if)\\b"
    },
    {
      "name": "entity.name.function",
      "match": "\\b[A-Za-z_$][\\w$]*(?=\\s*\\()"
    },
    {
      "name": "entity.name.type",
      "match": "\\b[A-Z][A-Za-z0-9_$]*\\b"
    },
    {
      "name": "constant.language",
      "match": "\\b(?:true|false|null|undefined|None|nil|NaN|Infinity|NULL|NoneType)\\b"
    }
  ]
}