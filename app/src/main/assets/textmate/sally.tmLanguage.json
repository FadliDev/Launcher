{
  "scopeName": "source.sally",
  "name": "Sally Universal Source",
  "patterns": [
    {"include": "#comments"},
    {"include": "#strings"},
    {"include": "#markup"},
    {"include": "#numbers"},
    {"include": "#constants"},
    {"include": "#keywords"},
    {"include": "#types"},
    {"include": "#functions"},
    {"include": "#properties"}
  ],
  "repository": {
    "comments": {
      "patterns": [
        {"name": "comment.block", "begin": "/\\*", "end": "\\*/"},
        {"name": "comment.line.double-slash", "match": "//.*$"},
        {"name": "comment.line.number-sign", "match": "#.*$"},
        {"name": "comment.line.double-dash", "match": "--.*$"}
      ]
    },
    "strings": {
      "patterns": [
        {"name": "string.quoted.triple.double", "begin": "\"\"\"", "end": "\"\"\""},
        {"name": "string.quoted.triple.single", "begin": "'''", "end": "'''"},
        {"name": "string.quoted.double", "begin": "\"", "end": "\"", "patterns": [{"name": "constant.character.escape", "match": "\\\\."}]},
        {"name": "string.quoted.single", "begin": "'", "end": "'", "patterns": [{"name": "constant.character.escape", "match": "\\\\."}]},
        {"name": "string.template", "begin": "`", "end": "`", "patterns": [{"name": "constant.character.escape", "match": "\\\\."}]}
      ]
    },
    "markup": {
      "patterns": [
        {"name": "entity.name.tag", "match": "</?[A-Za-z][A-Za-z0-9:_-]*|/?>"},
        {"name": "entity.other.attribute-name", "match": "\\b[A-Za-z_:][A-Za-z0-9:._-]*(?=\\s*=)"},
        {"name": "punctuation.definition.tag", "match": "<!doctype|<!--|-->"},
        {"name": "constant.character.entity", "match": "&(?:#[0-9]+|#x[0-9A-Fa-f]+|[A-Za-z][A-Za-z0-9]+);"}
      ]
    },
    "numbers": {
      "patterns": [
        {"name": "constant.numeric", "match": "(?<![\\w])(?:0[xX][0-9A-Fa-f]+|0[bB][01]+|0[oO][0-7]+|(?:[0-9]+\\.?[0-9]*|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?)[fFdDlLuU]*"}
      ]
    },
    "constants": {
      "patterns": [
        {"name": "constant.language", "match": "\\b(?:true|false|null|nil|None|none|undefined|NaN|Infinity|NULL|TRUE|FALSE|True|False|YES|NO)\\b"},
        {"name": "constant.other", "match": "\\b[A-Z][A-Z0-9_]{2,}\\b"}
      ]
    },
    "keywords": {
      "patterns": [
        {"name": "keyword.control", "match": "\\b(?:if|else|elif|then|fi|for|foreach|while|do|done|until|switch|case|match|when|break|continue|return|yield|throw|throws|try|catch|finally|except|raise|defer|go|select|async|await|as|in|of|is|not|and|or|xor|with|where|from|import|export|default|module|package|use|using|namespace|include|require|public|private|protected|internal|static|final|const|let|var|val|fun|fn|func|function|def|lambda|class|struct|enum|interface|trait|impl|extends|implements|extends|new|delete|operator|this|self|super|extends|abstract|override|virtual|inline|extern|volatile|synchronized|throws|typeof|instanceof|sizeof|type|typename|typedef|template|friend|go|chan|map|range|pub|mut|ref|move|dyn|unsafe|await|async|macro|where|select|fallthrough|pass|global|nonlocal|assert|print|echo|exit|exit\\s*\\(|return|end|fi|done)\\b"},
        {"name": "storage.type.primitive", "match": "\\b(?:void|bool|boolean|byte|char|short|int|long|float|double|decimal|string|String|object|Object|dynamic|var|any|unknown|never|number|bigint|symbol|list|dict|tuple|set|map|vector|uint|uint8|uint16|uint32|uint64|int8|int16|int32|int64|size_t|ssize_t|usize|isize|i8|i16|i32|i64|u8|u16|u32|u64|f32|f64)\\b"},
        {"name": "keyword.operator", "match": "(?:===|!==|==|!=|<=|>=|=>|->|::|\\?\\?|\\?\\.|\\+\\+|--|&&|\\|\\||\\+=|-=|\\*=|/=|%=|\\*\\*|<<|>>|=|\\+|-|\\*|/|%|!|<|>|\\?|:|\\.|\\||&)"}
      ]
    },
    "types": {
      "patterns": [
        {"name": "entity.name.type", "match": "\\b[A-Z][A-Za-z0-9_]*\\b"},
        {"name": "support.type", "match": "\\b(?:Array|String|Number|Boolean|Date|Math|Object|Promise|Map|Set|List|Dictionary|Optional|Result|Error|Exception|File|Path|System|Console|JSON|RegExp|Iterator|Iterable)\\b"}
      ]
    },
    "functions": {
      "patterns": [
        {"name": "entity.name.function", "match": "\\b[A-Za-z_$][A-Za-z0-9_$]*(?=\\s*\\()"}
      ]
    },
    "properties": {
      "patterns": [
        {"name": "variable.other.property", "match": "\\b[A-Za-z_$][A-Za-z0-9_$-]*(?=\\s*:)"},
        {"name": "punctuation.separator.key-value", "match": "[{}\\[\\]();,]"}
      ]
    }
  }
}
