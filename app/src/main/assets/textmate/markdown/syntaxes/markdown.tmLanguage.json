{
  "scopeName": "text.html.markdown",
  "name": "Markdown",
  "patterns": [
    {
      "name": "comment.block",
      "begin": "<!--",
      "end": "-->"
    },
    {
      "name": "markup.heading",
      "match": "^#{1,6}\\s.*$"
    },
    {
      "name": "markup.raw.block",
      "begin": "^\\s*```.*$",
      "end": "^\\s*```\\s*$"
    },
    {
      "name": "markup.inline.raw",
      "match": "`[^`\\n]+`"
    },
    {
      "name": "markup.bold",
      "match": "\\*\\*[^*\\n]+\\*\\*|__[^_\\n]+__"
    },
    {
      "name": "markup.italic",
      "match": "\\*[^*\\s][^*\\n]*\\*|\\b_[^_\\s][^_\\n]*_\\b"
    },
    {
      "match": "(!?\\[)([^\\]\\n]*)(\\])(\\()([^)\\n]*)(\\))",
      "captures": {
        "1": {
          "name": "punctuation.definition.tag"
        },
        "2": {
          "name": "markup.link.text"
        },
        "3": {
          "name": "punctuation.definition.tag"
        },
        "4": {
          "name": "punctuation.definition.tag"
        },
        "5": {
          "name": "markup.underline.link"
        },
        "6": {
          "name": "punctuation.definition.tag"
        }
      }
    },
    {
      "name": "markup.quote",
      "match": "^\\s*>.*$"
    },
    {
      "name": "markup.separator",
      "match": "^\\s*(?:-{3,}|\\*{3,}|_{3,})\\s*$"
    },
    {
      "match": "^\\s*(?:[-*+]|\\d+\\.)\\s(\\[[ xX]\\]\\s)?",
      "name": "punctuation.definition.list",
      "captures": {
        "1": {
          "name": "constant.language"
        }
      }
    }
  ]
}