{
  "name": "Sally Light",
  "type": "light",
  "colors": {
    "editor.background": "#FFFCFF",
    "editor.foreground": "#24212D",
    "editorCursor.foreground": "#594091",
    "editor.selectionBackground": "#D9CCF699",
    "editor.lineHighlightBackground": "#F5F0FA",
    "editorLineNumber.foreground": "#85808E",
    "editorLineNumber.activeForeground": "#3B3448",
    "editorSuggestWidget.background": "#F4EFFA",
    "editorSuggestWidget.foreground": "#24212D",
    "editorSuggestWidget.selectedBackground": "#E4D9F4",
    "editorSuggestWidget.highlightForeground": "#594091",
    "editorIndentGuide.background": "#E5DDEB",
    "editorWhitespace.foreground": "#D3CCD8",
    "editor.findMatchBackground": "#D7C4F0"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#7C7484",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#793DCB"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "markup.raw"
      ],
      "settings": {
        "foreground": "#287D45"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character"
      ],
      "settings": {
        "foreground": "#965D00"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#245CB6"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#087E8B"
      }
    },
    {
      "scope": [
        "entity.name.tag",
        "support.type.property-name.css"
      ],
      "settings": {
        "foreground": "#B44A13"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name",
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#80580C"
      }
    },
    {
      "scope": [
        "punctuation",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#555064"
      }
    }
  ]
}