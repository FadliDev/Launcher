{
  "scopeName": "source.cpp",
  "name": "C/C++",
  "patterns": [
    {
      "name": "meta.preprocessor",
      "match": "^\\s*#\\s*\\w+"
    },
    {
      "name": "comment.block",
      "begin": "/\\*",
      "end": "\\*/"
    },
    {
      "name": "comment.line",
      "match": "//.*$"
    },
    {
      "name": "string.quoted.double",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape",
          "match": "\\\\(?:u[0-9a-fA-F]{4}|.)"
        }
      ]
    },
    {
      "name": "string.quoted.single",
      "begin": "'",
      "end": "'",
      "patterns": [
        {
          "name": "constant.character.escape",
          "match": "\\\\(?:u[0-9a-fA-F]{4}|.)"
        }
      ]
    },
    {
      "name": "constant.numeric",
      "match": "\\b(?:0[xX][0-9a-fA-F_]+|0[bB][01_]+|\\d[\\d_]*(?:\\.\\d+)?(?:[eE][+-]?\\d+)?[fFLlDdUu]*)\\b"
    },
    {
      "name": "storage.type.annotation",
      "match": "@[A-Za-z_][\\w.]*"
    },
    {
      "match": "^\\s*(import|package)\\s+([\\w.*]+)",
      "captures": {
        "1": {
          "name": "keyword.declaration"
        },
        "2": {
          "name": "entity.name.namespace"
        }
      }
    },
    {
      "match": "\\b(class|struct|union|enum class|enum|namespace|typename|using|typedef|template)\\s+([A-Za-z_]\\w*)",
      "captures": {
        "1": {
          "name": "keyword.declaration"
        },
        "2": {
          "name": "entity.name.type"
        }
      }
    },
    {
      "name": "keyword.control",
      "match": "\\b(?:asm|break|case|catch|continue|default|delete|do|else|for|goto|if|new|return|sizeof|static_assert|switch|throw|try|typeid|while|alignas|alignof|decltype|noexcept|dynamic_cast|static_cast|const_cast|reinterpret_cast)\\b"
    },
    {
      "name": "storage.modifier",
      "match": "\\b(?:const|constexpr|explicit|export|extern|final|friend|inline|mutable|override|private|protected|public|register|static|virtual|volatile)\\b"
    },
    {
      "name": "storage.type.primitive",
      "match": "\\b(?:auto|bool|char|double|float|int|long|short|signed|unsigned|void|size_t|int8_t|int16_t|int32_t|int64_t|uint8_t|uint16_t|uint32_t|uint64_t|wchar_t|char16_t|char32_t)\\b"
    },
    {
      "name": "constant.language",
      "match": "\\b(?:true|false|nullptr|NULL|this)\\b"
    },
    {
      "name": "string.quoted.other",
      "match": "<[\\w./]+>"
    },
    {
      "name": "entity.name.function",
      "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?=\\s*\\()"
    },
    {
      "name": "variable.other.property",
      "match": "(?<=\\.)[A-Za-z_][A-Za-z0-9_]*\\b(?!\\s*\\()"
    },
    {
      "name": "constant.other",
      "match": "\\b[A-Z][A-Z0-9_]{2,}\\b"
    },
    {
      "name": "entity.name.type",
      "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
    },
    {
      "name": "keyword.operator",
      "match": "[-+*/%=<>!&|^~?:]+"
    }
  ]
}