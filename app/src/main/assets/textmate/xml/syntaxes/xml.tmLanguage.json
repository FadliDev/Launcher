{
  "scopeName": "text.xml",
  "name": "XML",
  "patterns": [
    {
      "name": "comment.block",
      "begin": "<!--",
      "end": "-->"
    },
    {
      "name": "string.unquoted.cdata",
      "begin": "<!\\[CDATA\\[",
      "end": "\\]\\]>"
    },
    {
      "name": "meta.preprocessor",
      "begin": "<\\?",
      "end": "\\?>"
    },
    {
      "begin": "(</?)([A-Za-z_][\\w:.-]*)",
      "end": "/?>",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.tag"
        },
        "2": {
          "name": "entity.name.tag"
        }
      },
      "patterns": [
        {
          "name": "entity.other.attribute-name",
          "match": "[A-Za-z_:][\\w:.-]*(?=\\s*=)"
        },
        {
          "name": "string.quoted.double",
          "begin": "\"",
          "end": "\""
        },
        {
          "name": "string.quoted.single",
          "begin": "'",
          "end": "'"
        }
      ]
    },
    {
      "name": "constant.character.entity",
      "match": "&\\w+;"
    }
  ]
}