{
  "scopeName": "text.xml",
  "name": "XML",
  "patterns": [
    {
      "name": "comment.block",
      "begin": "<!--",
      "end": "-->"
    },
    {
      "name": "string.unquoted.cdata",
      "begin": "<!\\[CDATA\\[",
      "end": "\\]\\]>"
    },
    {
      "name": "meta.preprocessor",
      "begin": "<\\?",
      "end": "\\?>"
    },
    {
      "begin": "(</?)([A-Za-z_][\\w.-]*)(?:(:)([A-Za-z_][\\w.-]*))?",
      "end": "/?>",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.tag"
        },
        "2": {
          "name": "entity.name.tag"
        },
        "3": {
          "name": "punctuation.definition.tag"
        },
        "4": {
          "name": "entity.name.tag"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.tag"
        }
      },
      "patterns": [
        {
          "name": "entity.other.attribute-name.namespace",
          "match": "[A-Za-z_][\\w.-]*(?=:[\\w.-]+\\s*=)"
        },
        {
          "name": "punctuation.definition.tag",
          "match": ":(?=[\\w.-]+\\s*=)"
        },
        {
          "name": "entity.other.attribute-name",
          "match": "[A-Za-z_][\\w.-]*(?=\\s*=)"
        },
        {
          "name": "keyword.operator",
          "match": "="
        },
        {
          "name": "string.quoted.double",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.other.reference",
              "match": "[@?]\\+?(?:[A-Za-z_.]+:)?[A-Za-z_]+/[\\w.]+"
            },
            {
              "name": "constant.character.entity",
              "match": "&\\w+;"
            }
          ]
        },
        {
          "name": "string.quoted.single",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.other.reference",
              "match": "[@?]\\+?(?:[A-Za-z_.]+:)?[A-Za-z_]+/[\\w.]+"
            }
          ]
        }
      ]
    },
    {
      "name": "constant.character.entity",
      "match": "&\\w+;"
    }
  ]
}