{
  "name": "Sally Dark",
  "type": "dark",
  "colors": {
    "editor.background": "#101116",
    "editor.foreground": "#DDE2F0",
    "editorCursor.foreground": "#D0BCFF",
    "editor.selectionBackground": "#3D355A99",
    "editor.lineHighlightBackground": "#191923",
    "editorLineNumber.foreground": "#777889",
    "editorLineNumber.activeForeground": "#E8E5F2",
    "editorSuggestWidget.background": "#1D1B25",
    "editorSuggestWidget.foreground": "#DDE2F0",
    "editorSuggestWidget.selectedBackground": "#39304F",
    "editorSuggestWidget.highlightForeground": "#D0BCFF",
    "editorIndentGuide.background": "#282733",
    "editorWhitespace.foreground": "#33313F",
    "editor.findMatchBackground": "#5D4B83"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#7D879C",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#C6A0F6"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "markup.raw"
      ],
      "settings": {
        "foreground": "#A6D189"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character"
      ],
      "settings": {
        "foreground": "#E5C890"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#8AADF4"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#91D7E3"
      }
    },
    {
      "scope": [
        "entity.name.tag",
        "support.type.property-name.css"
      ],
      "settings": {
        "foreground": "#F5A97F"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name",
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#EED49F"
      }
    },
    {
      "scope": [
        "punctuation",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#B8C0E0"
      }
    },
    {
      "scope": [
        "invalid"
      ],
      "settings": {
        "foreground": "#FFFFFF",
        "background": "#E64553"
      }
    }
  ]
}