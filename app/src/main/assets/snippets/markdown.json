{
  "h1": {
    "prefix": "h1",
    "body": "# ${1:Heading}",
    "description": "Heading 1"
  },
  "code": {
    "prefix": "code",
    "body": "```$1\n$0\n```",
    "description": "Fenced code block"
  },
  "link": {
    "prefix": "link",
    "body": "[${1:title}](${2:https://example.com})",
    "description": "Markdown link"
  }
}