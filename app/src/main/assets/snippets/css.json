{
  "flex": {
    "prefix": "flex",
    "body": "display: flex;\nalign-items: center;\njustify-content: center;",
    "description": "Centered flex layout"
  },
  "grid": {
    "prefix": "grid",
    "body": "display: grid;\ngrid-template-columns: repeat(${1:2}, minmax(0, 1fr));\ngap: ${2:1rem};",
    "description": "CSS grid"
  },
  "media": {
    "prefix": "media",
    "body": "@media (max-width: ${1:768px}) {\n    $0\n}",
    "description": "Responsive media query"
  },
  "var": {
    "prefix": "var",
    "body": "--${1:primary-color}: ${2:#6750a4};",
    "description": "CSS custom property"
  }
}